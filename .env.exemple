COMPOSE_PROJECT_NAME=hypertube

# Database
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hypertube
DATABASE_URL=postgres://hypertube:changeme@postgres:5432/hypertube?sslmode=disable

# TMDb
TMDB_API_KEY=

#C 411
C411_API_KEY=

# 42 OAuth
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_REDIRECT_URL=http://localhost:8080/api/v1/auth/42/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:4200/en/auth/callback

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# Email (password reset)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_URL=http://localhost:4200/{locale}/reset-password

# VPN — Private Internet Access credentials (used by torrent-transcode container)
PIA_USER=
PIA_PASSWORD=
PIA_REGION=

# GitLab OAuth
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URL=http://localhost:8080/api/v1/auth/gitlab/callback

# Auth
JWT_SECRET=

# Frontend environment variables
NEXT_PUBLIC_OPENSUBTITLES_API_KEY=
NEXT_PUBLIC_OPENSUBTITLES_USERNAME=
NEXT_PUBLIC_OPENSUBTITLES_PASSWORD=
